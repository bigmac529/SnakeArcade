# SnakeArcade settings. Copy to .env for local development (gitignored).
# On the production server keep the real file OUTSIDE the web folder, e.g.
#   C:\WebApps\SnakeArcade-config\snakearcade.env
# and point the service at it with SNAKEARCADE_ENV_FILE (see docs/database-setup.md).
# Real environment variables win over lines in this file. One KEY=value per line.
# " #" after an unquoted value starts a comment; put a value that contains " #"
# (or starts/ends with spaces) in quotes: SMTP_PASSWORD="abc #123".
# NEVER commit a file with real passwords or secrets.

# ---- App ----
# NODE_ENV=production            # production: requires SESSION_SECRET, secure cookies, HSTS
PORT=3023                        # production service: 3105
HOST=localhost                   # keep localhost: IIS/ARR is the public front door
# PUBLIC_BASE_URL=https://snakearcade.socha3.com   # used in email links + Origin check; default http://localhost:PORT
# ALLOWED_ORIGINS=               # extra allowed origins, comma separated (rarely needed)
# TRUST_PROXY=true               # behind IIS/ARR/Cloudflare: take the visitor IP from CF-Connecting-IP / X-Forwarded-For

# ---- Sessions ----
# SESSION_SECRET=                # REQUIRED in production: 32+ random characters (secret). Changing it signs everyone out.
#                                # PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }) -as [byte[]])
#                                # or: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# COOKIE_SECURE=                 # default: true in production or when PUBLIC_BASE_URL is https
# SESSION_DAYS=30

# ---- Database ----
DB_CLIENT=sqlite                 # sqlite (local) | mssql (production)
# SQLITE_FILE=data/snakearcade.db

# SQL Server: either one connection string ...
# DB_CONNECTION_STRING=Server=SQLHOST,1433;Database=SnakeArcade;User Id=snakearcade_app;Password=CHANGE_ME;Encrypt=true;TrustServerCertificate=false
# DB_MIGRATION_CONNECTION_STRING=Server=SQLHOST,1433;Database=SnakeArcade;User Id=snakearcade_migrator;Password=CHANGE_ME;Encrypt=true;TrustServerCertificate=false
# ... or the separate parts:
# DB_SERVER=SQLHOST
# DB_PORT=1433
# DB_INSTANCE=                   # named instance (uses SQL Browser, UDP 1434) instead of DB_PORT
# DB_NAME=SnakeArcade
# DB_USER=snakearcade_app
# DB_PASSWORD=
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERTIFICATE=false   # true only for a self-signed SQL certificate on the same trusted network
# DB_MSSQL_DRIVER=tedious        # tedious (SQL login over TCP) | msnodesqlv8 (Windows auth via ODBC; npm install msnodesqlv8)
# DB_MIGRATE_ON_START=true       # false if the app login has no DDL rights (run npm run migrate at deploy instead)

# ---- Email (confirmation + password reset) ----
# Empty SMTP_HOST = emails are written as JSON files to MAIL_OUTBOX_DIR (local dev only).
# Production: the socha3.com mailbox over authenticated SMTP.
#   587 + SMTP_SECURE=false  -> STARTTLS (TLS is required, never plain text)
#   465 + SMTP_SECURE=true   -> TLS from the start
# SMTP_HOST=mail.socha3.com      # your mail provider's SMTP host
# SMTP_PORT=587
# SMTP_SECURE=false              # default: true when SMTP_PORT=465
# SMTP_USER=no-reply@socha3.com
# SMTP_PASSWORD=                 # secret: server only, never commit
# MAIL_FROM=SnakeArcade <no-reply@socha3.com>
# MAIL_REPLY_TO=                 # optional, e.g. a monitored address
# MAIL_OUTBOX_DIR=data/outbox

# ---- Limits (defaults shown) ----
# RATE_LIMIT_SIGNUP_PER_HOUR=5           # per IP
# RATE_LIMIT_LOGIN_PER_15MIN=10          # per account (failed attempts)
# RATE_LIMIT_LOGIN_IP_PER_15MIN=50       # per IP (failed attempts)
# RATE_LIMIT_RESEND_COOLDOWN_SECONDS=60
# RATE_LIMIT_RESEND_PER_DAY=5
# RATE_LIMIT_FORGOT_PER_HOUR=3           # per account
# RATE_LIMIT_FORGOT_IP_PER_HOUR=20       # per IP
# VERIFY_TOKEN_HOURS=24
# RESET_TOKEN_MINUTES=60
